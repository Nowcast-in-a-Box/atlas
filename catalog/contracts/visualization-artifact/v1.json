{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nib://contracts/visualization-artifact/v1",
  "title": "VisualizationArtifact Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type", "artifact_kind", "formats", "time_axis_capability"],
  "properties": {
    "contract_type": { "const": "visualization_artifact" },
    "artifact_kind": { "enum": ["map", "animation", "interactive_document"] },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/format" }
    },
    "time_axis_capability": { "enum": ["none", "valid_time", "lead_time"] }
  },
  "$defs": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
